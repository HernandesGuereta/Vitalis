{
  "name": "@vitalis/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.ts",
    "dev:lan": "node --env-file-if-exists=../../.env --watch src/server.ts --lan",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "node --test tests/alerts.test.ts tests/security.test.ts",
    "test:db": "node --env-file-if-exists=../../.env --test tests/database.test.ts tests/appointments.test.ts tests/stock.test.ts",
    "db:migrate": "node --env-file-if-exists=../../.env src/db/cli.ts migrate",
    "db:role": "node --env-file-if-exists=../../.env src/db/cli.ts role",
    "db:seed": "node --env-file-if-exists=../../.env src/db/cli.ts seed",
    "db:cleanup": "node --env-file-if-exists=../../.env src/db/cli.ts cleanup",
    "start": "node --env-file-if-exists=../../.env dist/server.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "8.23.1"
  }
}
