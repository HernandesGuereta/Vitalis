{
  "name": "@vitalis/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "node --test tests/model.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "expo install --check",
    "export": "expo export --platform android --platform ios --output-dir dist",
    "export:web": "expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2"
  }
}
