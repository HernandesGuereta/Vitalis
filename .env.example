# Ambiente local de desenvolvimento
HOST=127.0.0.1
PORT=3000

POSTGRES_USER=vitalis
# Defina uma senha própria antes da primeira criação do volume do PostgreSQL.
POSTGRES_PASSWORD=DEFINA_SENHA_DO_POSTGRES
POSTGRES_DB=vitalis
POSTGRES_PORT=5432

# Conexão usada pela API, migrações e seed.
# Atualize esta URL ao alterar os valores do PostgreSQL acima.
# Somente os comandos de manutenção utilizam o usuário dono do banco.
DATABASE_ADMIN_URL=postgresql://vitalis:DEFINA_SENHA_DO_POSTGRES@127.0.0.1:5432/vitalis
# Defina uma senha distinta com ao menos 12 caracteres e execute db:role.
DATABASE_URL=postgresql://vitalis_app:DEFINA_UMA_SENHA_FORTE@127.0.0.1:5432/vitalis

# Defina duas senhas distintas com ao menos 12 caracteres antes de db:seed.
DEMO_DONOR_PASSWORD=
DEMO_ADMIN_PASSWORD=

# HTTP com senhas é limitado ao próprio computador por padrão.
# Somente para testar dados fictícios na mesma rede, habilite conscientemente.
ALLOW_INSECURE_DEMO_LAN=false
# Para HTTPS direto na API, informe arquivos de certificado e chave válidos:
TLS_CERT_FILE=
TLS_KEY_FILE=
# Endereço público usado pelo renderer desktop; nunca coloque senhas em VITE_*.
VITE_API_URL=http://127.0.0.1:3000
# Origens web adicionais, exatas, separadas por vírgula; nunca use '*'.
ALLOWED_ORIGINS=
# Definir antes de um piloto com pessoas reais:
PRIVACY_CONTACT=

# Banco separado para testes de integração; nunca use um banco de produção.
TEST_DATABASE_URL=postgresql://vitalis:DEFINA_SENHA_DO_POSTGRES@localhost:5432/vitalis_test
